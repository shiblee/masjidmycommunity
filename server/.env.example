PORT=5050
DB_HOST=localhost
DB_PORT=8889
DB_NAME=masjidmycommunity
DB_USER=root
DB_PASSWORD=root
JWT_SECRET=change-this-secret

# Optional — only set this once the server sits behind a reverse proxy/load
# balancer (Nginx, Cloudflare, ALB, etc.) that you control, so the client IP
# recorded in login activity logs is accurate instead of the proxy's own IP.
# Leave unset for local dev and any deployment with no proxy in front.
# Accepts: a hop count (e.g. "1" for exactly one proxy in front), or a
# comma-separated list of trusted proxy IPs/CIDRs. Do NOT set this unless
# you know the request truly passes through that many/those trusted hops —
# setting it wrongly lets a client spoof its own IP via X-Forwarded-For.
TRUST_PROXY=

# Optional — configure to send real emails (welcome + OTP emails).
# Without these, emails are logged to the console instead (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Masjid My Community <hello@masjidmycommunity.org>

# Optional — powers the FAQ page's "Ask AI" assistant. Without a key, the
# assistant clearly shows as "not configured" and the rest of the FAQ page
# (browsing, search, categories) works normally. AI_PROVIDER selects which
# key is used ("claude" or "gemini"); AI_MODEL/AI_EFFORT are optional
# overrides. FAQ_AI_CONFIDENCE_THRESHOLD tunes how relevant retrieved
# content must be before the AI is called at all (0-1, higher = stricter).
AI_PROVIDER=claude
AI_MODEL=
AI_EFFORT=low
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
FAQ_AI_CONFIDENCE_THRESHOLD=0.15
